APP_NAME=Java Internal RAG Service
INTERNAL_API_PREFIX=/internal/rag
RAG_SERVICE_TOKEN=change-me
SA_TOKEN_JWT_SECRET=<same-as-java-sa-token-jwt-secret>
SA_TOKEN_JWT_ALGORITHM=HS256
DATABASE_URL=postgresql+asyncpg://postgres:<password>@host.docker.internal:5432/ruoyi-ai
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://localhost:9002
MINIO_DOCUMENTS_BUCKET=rag-documents
MINIO_PARSED_BUCKET=rag-parsed
MINIO_PREVIEW_BUCKET=rag-preview
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-v4-flash
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
RERANK_API_KEY=
RERANK_MODEL=qwen3-vl-rerank
RERANK_ENABLED=true
CHUNK_SIZE=800
CHUNK_OVERLAP=120
VECTOR_TOP_K=30
KEYWORD_TOP_K=30
QA_TOP_K=10
RERANK_TOP_K=5
OCR_ENABLED=true
OCR_LANG=ch
OCR_USE_GPU=false
