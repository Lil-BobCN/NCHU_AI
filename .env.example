DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
STREAM_CHAR_DELAY_MS=0
CHAT_MAX_QUESTION_CHARS=2000
CHAT_MAX_TOP_K=30
CHAT_MAX_RERANK_TOP_K=10
CHAT_MAX_CONCURRENT_REQUESTS=20
CHAT_GLOBAL_MAX_CONCURRENT_REQUESTS=0
CHAT_DISTRIBUTED_CONCURRENCY_ENABLED=true
CHAT_SLOT_TTL_SECONDS=300
CHAT_SUMMARY_MODEL_ENABLED=false
CHAT_SUGGESTED_QUESTIONS_MODEL_ENABLED=false
CHAT_QUEUE_TIMEOUT_SECONDS=0.05
MODEL_REQUEST_TIMEOUT_SECONDS=90
MODEL_REQUEST_RETRIES=2
MODEL_MAX_CONCURRENT_REQUESTS=20

EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_CONCURRENT_REQUESTS=8
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SECONDS=604800

RERANK_API_KEY=your-rerank-api-key
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-vl-rerank
RERANK_ENABLED=true
RERANK_MAX_CANDIDATES=10
RERANK_REQUEST_TIMEOUT_SECONDS=30
RERANK_REQUEST_RETRIES=1
RERANK_MAX_CONCURRENT_REQUESTS=20
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=1800
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=3600

TABLE_CHUNK_ROWS=50
TABLE_FULL_INDEX_MAX_ROWS=500
TABLE_SAMPLE_ROWS=50
MAX_DOCUMENT_CHUNKS=300
MAX_EMBEDDING_CHARS_PER_DOCUMENT=200000
RETRIEVAL_MAX_QUERY_CHARS=2000
RETRIEVAL_MAX_TOP_K=50
RETRIEVAL_MAX_RERANK_TOP_K=20

DATABASE_URL=postgresql+asyncpg://rag:rag@127.0.0.1:5433/rag
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://127.0.0.1:6380/0
BACKGROUND_TASK_QUEUE_KEY=rag:background_tasks
BACKGROUND_WORKER_CONCURRENCY=1
BACKGROUND_WORKER_POLL_TIMEOUT_SECONDS=5

MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://localhost:9002

